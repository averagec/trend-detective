{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "nasa": {
      "root": "nasa",
      "framework": "flask",
      "entrypoint": "app.py"
    },
    "web": {
      "root": "nasa/web",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "nasa" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
